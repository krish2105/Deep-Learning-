# ─── Copy to .env and fill in. NEVER commit .env — this repo is public. ───

# ── Orchestrator (apps/api → Render) ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase Postgres. Project Settings → Database → Connection string (URI).
# Use the pooled connection (port 6543) — Render free tier has few connections.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:6543/postgres

# Supabase Storage (radiograph uploads)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=studies

# HF Spaces inference core. Leave blank to force the ONNX fast path only.
INFERENCE_URL=https://YOUR-USER-sentinel-cxr.hf.space
INFERENCE_TIMEOUT_S=25

# Gemini — OPTIONAL. Without it the app uses deterministic template reports
# and remains fully functional. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Conformal calibration
CONFORMAL_ALPHA=0.10          # 1 - alpha = 90% nominal coverage
CONFORMAL_MAX_SET_SIZE=6      # larger prediction set ⇒ abstain
OOD_THRESHOLD=0.045           # VAE reconstruction-error cutoff

# CORS — your Vercel deployment
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-APP.vercel.app

# ── Frontend (apps/web → Vercel) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
