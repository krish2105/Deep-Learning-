# Secrets — never commit. This repo is public.
.env
.env.local
.env.*.local
*.pem
*.key
service-account*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Node
node_modules/
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
.turbo/

# Models & data — too large for git, fetched at build/run time
*.pth
*.pt
# ONNX: the int8 classifier IS committed (7.9 MB) so the orchestrator can
# serve real predictions with no external inference service. Larger fp32
# intermediates stay ignored.
*_fp32.onnx
*.h5
*.ckpt
data/
weights/
!weights/.gitkeep

# Training scratch output is ignored, but the DEPLOYED artefacts are tracked:
# the int8 classifier (7.9 MB) so the orchestrator needs no external inference
# service, and the calibration/policy/fairness JSON the notebooks export.
artifacts/
!apps/api/artifacts/
!apps/api/artifacts/.gitkeep
!apps/api/artifacts/*.onnx
!apps/api/artifacts/*.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Logs
*.log
npm-debug.log*
.vercel

# Local HF Space working clone and its zip — pushed to huggingface.co, not here
hf-space/
sentinel-cxr-space.zip

# Local SQLite dev database
apps/api/sentinel.db
